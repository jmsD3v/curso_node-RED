    {
        "id": "d7534dd767d684df",
        "type": "function",
        "z": "c71559f8645e5404",
        "name": "Obtener Timestamp",
        "func": "const fecha = new Date();\n\nconst anio = fecha.getFullYear();\nconst mes = (\"0\" + (fecha.getMonth() + 1)).slice(-2);\nconst dia = (\"0\" + fecha.getDate()).slice(-2);\nconst hora = (\"0\" + fecha.getHours()).slice(-2);\nconst minutos = (\"0\" + fecha.getMinutes()).slice(-2);\nconst segundos = (\"0\" + fecha.getSeconds()).slice(-2);\n\nlet timestamp = anio + \"-\" + mes + \"-\" + dia + \"-\" + hora + \"-\" + minutos + \"-\" + segundos + \"-\";\n\nflow.set(\"timestamp\", timestamp);\n\nmsg.payload = timestamp;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 100,
        "wires": [
            []
        ]
    },
