        "z": "1b34e4de264ccc53",
        "name": "Suma de nros",
        "func": "// Sumo los valores recibidos desde el Inject\nconst resultado = msg.nro_1 + msg.nro_2;\n\n// Envío el resultado en payload\nmsg.payload = resultado;\n\n// Si es > 50 → salida 1, si no → salida 2\nif (resultado > 50) {\n    return [msg, null];\n} else {\n    return [null, msg];\n}\n",
