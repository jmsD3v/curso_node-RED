    {
        "id": "maxPot",
        "type": "function",
        "z": "2359afb028aabe3c",
        "name": "Calcular Potencia Máxima",
        "func": "flow.set(\"potencia_max\", msg.payload[0].potencia);\n\nfor (let i = 1; i < msg.payload.length; i++) {\n    if (flow.get(\"potencia_max\") < msg.payload[i].potencia) {\n        flow.set(\"potencia_max\", msg.payload[i].potencia);\n    }\n}\n\nmsg.payload = flow.get(\"potencia_max\");\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
